---
interface Props {
  heading?: string;
  body?: string;
  href?: string;
  label?: string;
  demo?: boolean;
}

const {
  heading = "Own what your business knows.",
  body = "Twenty minutes on a call about your business. If it's a fit, your AIOS and HQ are live 10 business days after setup.",
  href = "/book-a-call",
  label = "Book a Call",
  demo = true,
} = Astro.props;
---

<section class="close">
  <div class="wrap inner">
    <h2>{heading}</h2>
    <p>{body}</p>
    <div class="actions">
      <a class="btn" href={href}>{label} <svg class="arrow"><use href="#arrow" /></svg></a>
      {demo && <a class="text-link" href="/demo">Or see a demo with your business in it first <svg class="arrow"><use href="#arrow" /></svg></a>}
    </div>
  </div>
</section>

<style>
  .close { position: relative; overflow: hidden; text-align: center; padding-block: clamp(90px, 11vw, 140px) clamp(100px, 12vw, 150px); }
  .close::before {
    content: ""; position: absolute; left: 50%; bottom: -40%; width: 1100px; max-width: 160%; height: 90%; transform: translateX(-50%);
    background: radial-gradient(ellipse 50% 50% at 50% 100%, var(--glow), transparent 70%);
    opacity: 0.55; filter: blur(10px); pointer-events: none;
  }
  .inner { position: relative; }
  h2 { font-size: clamp(36px, 4.6vw, 60px); max-width: 15em; margin: 0 auto; }
  p { color: var(--muted); font-size: 19px; margin: 22px auto 0; max-width: 28em; text-wrap: pretty; }
  .actions { margin-top: 36px; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 18px 28px; }
  @media (max-width: 560px) { p { font-size: 17px; } }
</style>
