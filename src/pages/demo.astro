---
// The demo request page (November 23, 2026). The form posts to functions/api/demo-request.ts, and the
// AIOS Demo Builder task builds and emails the demo with no review (Mark's call).
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../lib/site";

const gets = [
  ["Your name on it", "Your logo and your company's name, in an app that runs like the real thing."],
  ["Your kind of work", "Your services and how you sell them, read from your website, on boards with your kind of stages."],
  ["Something on every screen", "Made-up customers, jobs, and numbers, so you can see what each part does."],
  ["What the AI drafts", "Estimates, follow-ups, and customer emails the AI wrote for your kind of business, waiting for a person to approve."],
];
---

<BaseLayout
  title="See a Demo for Your Business - Motive11"
  description="Give me your name, email, and website, and I'll build a demo with your business in it."
  noindex
>
  <section class="intro">
    <div class="wrap narrow">
      <span class="label">See it with your business in it</span>
      <h1>See what your business looks like on its own AIOS.</h1>
      <p class="lead">Give me your name, your email, and your website. I'll build a demo with your business in it, and send you the link so you can click around and get a feel for it.</p>

      <div data-demo-box data-sitekey={site.turnstileSiteKey}>
        <form class="demo-form" data-demo novalidate>
          <label><span>First name</span><input type="text" name="first" autocomplete="given-name" maxlength="40" required /></label>
          <label><span>Email</span><input type="email" name="email" autocomplete="email" required /></label>
          <label><span>Your company's website</span><input type="text" name="site" inputmode="url" autocomplete="url" placeholder="yourcompany.com" required /></label>
          <p class="demo-err" data-demo-err hidden></p>
          <button class="btn" type="submit">Build My Demo <svg class="arrow"><use href="#arrow" /></svg></button>
          <div class="demo-ts"></div>
        </form>
        <div class="demo-done" data-demo-done hidden>
          <h2>Building it now.</h2>
          <p>I'll email you the link, usually within the hour. It stays up for 14 days, so click around while it's there.</p>
        </div>
      </div>
      <p class="consent">I'll also add you to my weekly email for owners: what I built for a client, what it took, and what it changed. Unsubscribe any time.</p>
      <p class="sample">Want to look first? <a class="text-link" href="https://demo.motive11.com/halden-roofing" target="_blank" rel="noopener">Click around a sample for a made-up roofing company <svg class="arrow"><use href="#arrow" /></svg></a></p>
    </div>
  </section>

  <section class="block">
    <div class="wrap narrow">
      <h2>What you'll get</h2>
      <div class="gets">
        {gets.map(([t, d]) => <div class="get"><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="block isnt-sec">
    <div class="wrap narrow">
      <div class="isnt">
        <h2>What it isn't</h2>
        <p>It's a demo, built only from what's public on your website. Every customer, job, and number in it is made up.</p>
        <p>The real thing starts with your data and your people: your systems connected, your team interviewed, and everything about how you work written down. That takes about 10 business days, and it's what the Build is for.</p>
        <div class="actions">
          <a class="btn" href="/book-a-call">Rather just talk? Book a Call <svg class="arrow"><use href="#arrow" /></svg></a>
          <a class="text-link" href="/process">How the Build works <svg class="arrow"><use href="#arrow" /></svg></a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var box = document.querySelector("[data-demo-box]");
    if (!box) return;
    var form = box.querySelector("[data-demo]");
    var err = box.querySelector("[data-demo-err]");
    var loading = null;
    function turnstileReady() {
      if (window.turnstile) return Promise.resolve(window.turnstile);
      if (!loading) {
        loading = new Promise(function (resolve, reject) {
          var s = document.createElement("script");
          s.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
          s.async = true;
          s.onload = function () { resolve(window.turnstile); };
          s.onerror = reject;
          document.head.appendChild(s);
        });
      }
      return loading;
    }
    function token() {
      return turnstileReady().then(function (ts) {
        return new Promise(function (resolve, reject) {
          var slot = box.querySelector(".demo-ts");
          if (slot.dataset.wid) ts.remove(slot.dataset.wid);
          slot.dataset.wid = ts.render(slot, {
            sitekey: box.dataset.sitekey, execution: "execute", appearance: "interaction-only",
            theme: document.documentElement.classList.contains("dark") ? "dark" : "light",
            callback: resolve, "error-callback": function () { reject(new Error("Verification failed. Please try again.")); },
          });
          ts.execute(slot);
        });
      });
    }
    function fail(msg, field) {
      err.textContent = msg; err.hidden = false;
      if (field) field.focus();
    }
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var btn = form.querySelector("button");
      if (btn.disabled) return;
      var first = form.first.value.trim();
      var email = form.email.value.trim();
      var site = form.site.value.trim();
      err.hidden = true;
      if (!first) return fail("What should I call you?", form.first);
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail("That email doesn't look right.", form.email);
      if (!/^(https?:\/\/)?[^\s\/]+\.[^\s]+$/i.test(site)) return fail("That website doesn't look right.", form.site);
      var label = btn.innerHTML;
      btn.disabled = true; btn.textContent = "One sec";
      token()
        .then(function (t) {
          return fetch("/api/demo-request", {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ first: first, email: email, site: site, token: t }),
          });
        })
        .then(function (r) {
          return r.json().catch(function () { return {}; }).then(function (d) {
            if (!r.ok) throw new Error(d.error || "Something went wrong. Please try again.");
          });
        })
        .then(function () {
          form.hidden = true;
          box.querySelector("[data-demo-done]").hidden = false;
          if (window.mjsTrack) window.mjsTrack("Demo requested");
        })
        .catch(function (x) {
          btn.disabled = false; btn.innerHTML = label;
          fail(x.message || "Something went wrong. Please try again.");
        });
    });
  })();
</script>

<style>
  .narrow { max-width: 820px; }
  .intro { padding-block: clamp(64px, 9vw, 112px) clamp(24px, 4vw, 48px); }
  .lead { margin-top: 22px; color: var(--muted); font-size: 20px; line-height: 1.55; }
  .demo-form { display: grid; gap: 16px; margin-top: 36px; background: var(--surface); border: 1px solid rgba(255, 106, 26, 0.45); border-radius: 18px; padding: clamp(22px, 3vw, 32px); }
  .demo-form label { display: grid; gap: 8px; font-size: 15px; color: var(--muted); }
  .demo-form input { font: inherit; font-size: 17px; color: var(--fg); background: transparent; border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; }
  .demo-form input:focus { outline: none; border-color: var(--orange); }
  .demo-form .btn { justify-self: start; margin-top: 6px; }
  .consent { margin-top: 12px; color: var(--faint); font-size: 14px; line-height: 1.5; max-width: 40em; }
  .demo-err { color: #E5484D; font-size: 15px; }
  .demo-ts:empty { display: none; }
  .demo-done { margin-top: 36px; background: var(--surface); border: 1px solid rgba(255, 106, 26, 0.45); border-radius: 18px; padding: clamp(22px, 3vw, 32px); }
  .demo-done h2 { font-size: clamp(26px, 3vw, 34px); }
  .demo-done p { margin-top: 12px; color: var(--muted); font-size: 18px; line-height: 1.55; }
  .sample { margin-top: 22px; color: var(--muted); display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: center; }
  .gets { display: grid; gap: 14px; margin-top: 32px; }
  .get { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 24px; }
  .get h3 { font-weight: 500; font-size: 20px; letter-spacing: -0.02em; }
  .get p { margin-top: 8px; color: var(--muted); font-size: 16px; line-height: 1.55; }
  .isnt { border-top: 1px solid var(--line); padding-top: clamp(36px, 5vw, 56px); }
  .isnt p { margin-top: 16px; color: var(--muted); font-size: 18px; line-height: 1.6; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 28px; }
  @media (min-width: 760px) { .gets { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
