---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientLogos from "../components/ClientLogos.astro";
import ClosingCta from "../components/ClosingCta.astro";
import { site } from "../lib/site";
import { pricing, usd } from "../lib/pricing";
import AfterBuild from "../components/build/AfterBuild.astro";
import AiosScreens from "../components/build/AiosScreens.astro";
const build = usd(pricing.build.rate);
const day = usd(pricing.onboardingDay.rate);
const ownerTime: [string, number][] = [["Call", 20], ["Form", 10], ["Setup", 90], ["Interview", 90], ["Read-back", 30], ["Training", 60]];
import Testimonial from "../components/Testimonial.astro";
import { fetchTestimonial } from "../lib/testimonials";
import portrait from "../assets/mark/portrait.webp";
import ownImg from "../assets/case-studies/my-own-aios/work-hq-pipelines.webp";
import shefflerImg from "../assets/case-studies/sheffler-and-company/portal-leads-queue.webp";
// The still is frame one of its recording, so the video takes over without a jump. scripts/showcase/aios_demo.py
// records the fictional Halden demo; bump -vN on a re-record, since the files are cached as immutable.
import aiosDemo from "../assets/showcase/aios.webp";

// Bud Sheffler's, because it has his photo. The excerpt is his own words, the same lines the Fractional page uses.
const bud = await fetchTestimonial("8b67a481-a547-4d8f-a6e1-c4554bb6f0fe");
const quote = bud && { ...bud, text: "When my team finds something that needs to change, Mark fixes it fast, often the same day. At this point he knows how our business runs as well as anyone in the building." };

const showcase = [
  { img: aiosDemo, video: "/showcase/aios-v2.mp4", addr: "demo.motive11.com/halden-roofing", alt: "Clicking through a demo AIOS for a made-up roofing company: today's numbers, the jobs board, one job, the AI's drafts waiting for review, and the written-down business", caption: "A demo AIOS for Halden Roofing, a made-up company. Every name and number in it is invented", href: "https://demo.motive11.com/halden-roofing" },
];
const lockIcon = "M5 7V5a3 3 0 0 1 6 0v2h.5A1.5 1.5 0 0 1 13 8.5v5a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 3 13.5v-5A1.5 1.5 0 0 1 4.5 7H5Zm1.5 0h3V5a1.5 1.5 0 0 0-3 0v2Z";
---

<BaseLayout
  title="Motive11 - Custom AI Systems You Own"
  description={site.description}
>
  <div class="hero">
    <div class="wrap">
      <h1>Your business has no single source of truth. That's costing you. Let me fix it.</h1>
      <p class="sub">Your data is spread across people, inboxes, and AI accounts your business doesn't control, and nobody has the real answer. I'm <span class="name">Mark Szymanski</span>. I build your company its own AI Operating System (AIOS), all of its data in one place every AI on your team works from, and an HQ, the app your team runs the business on. Built in your accounts, so <b>you own all of it.</b></p>
      <div class="actions">
        <a class="btn" href="/book-a-call">Book a Call <svg class="arrow"><use href="#arrow" /></svg></a>
        <a class="text-link" href="/demo">See a demo for your business <svg class="arrow"><use href="#arrow" /></svg></a>
      </div>

      <div class="stage" data-showcase>
        <div class="browser">
          <div class="bar">
            <div class="lights"><i></i><i></i><i></i></div>
            <div class="addr"><svg class="lock" viewBox="0 0 16 16" aria-hidden="true"><path d={lockIcon} /></svg><span data-addr>{showcase[0].addr}</span></div>
            <div class="spacer"></div>
          </div>
          <div class="screens" data-track>
            {showcase.map((s, i) => (
              <div class:list={["screen", { "is-on": i === 0 }]} data-screen data-addr-text={s.addr} data-caption={s.caption} data-href={s.href}>
                <Image src={s.img} alt={s.alt} widths={[800, 1400, 2200]} sizes="(min-width: 1140px) 1100px, 100vw" loading="eager" />
                {s.video && <video muted loop playsinline preload="none" aria-hidden="true" data-video={s.video}></video>}
              </div>
            ))}
          </div>
        </div>
        <div class="showcase-foot">
          <p class="caption"><span data-cap>{showcase[0].caption}</span>. <a href={showcase[0].href} data-caption-link target="_blank" rel="noopener">Click around it yourself</a></p>
          <div class="dots" role="group" aria-label="Projects" hidden={showcase.length < 2}>
            {showcase.map((s, i) => (
              <button type="button" class:list={["dot", { "is-on": i === 0 }]} aria-label={s.addr} aria-current={i === 0 ? "true" : undefined} data-dot={i}></button>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="wrap logos-wrap"><ClientLogos /></div>

  <section class="block risk-sec">
    <div class="wrap">
      <span class="label">The risk</span>
      <h2>Three ways it gets lost right now.</h2>
      <p class="risk-lead">Nobody took it on purpose. It's just scattered, and it's gone the day something changes.</p>
      <div class="risks">
        <div class="risk reveal">
          <span class="r-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 19c0-2.8-2.5-5-5.5-5S3 16.2 3 19M8.5 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM16 11h6" /></svg></span>
          <h3>Someone leaves</h3>
          <p>You shut off their account, and everything they taught it goes with them. The next person starts from zero.</p>
          <div class="chips gone" aria-hidden="true"><span>Their prompts</span><span>Their files</span><span>How they did the job</span></div>
        </div>
        <div class="risk reveal">
          <span class="r-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h13l-3-3M20 17H7l3 3" /></svg></span>
          <h3>You switch AI tools</h3>
          <p>Everything your team built up inside one AI company's app stays there. Change tools, or the tool changes, and you start over.</p>
          <div class="chips gone" aria-hidden="true"><span>Memories</span><span>Projects</span><span>Custom assistants</span></div>
        </div>
        <div class="risk reveal">
          <span class="r-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 3h7v5h-7zM15 13h5v8h-5zM3 15h8v5H3z" /></svg></span>
          <h3>There's no one answer</h3>
          <p>Five people, five tools, five versions of the numbers. Every question means asking around, and every handoff loses something.</p>
          <div class="chips scattered" aria-hidden="true"><span>ChatGPT</span><span>Claude</span><span>Copilot</span><span>Gemini</span><span>A notes app</span></div>
        </div>
      </div>
      <p class="fix">The fix is one AIOS in the company's name: what the business knows and the data it runs on, in one place you own. Everyone's AI works from it, and when someone leaves, nothing goes with them.</p>
    </div>
  </section>

  <section class="block simple-sec" id="build">
    <div class="wrap">
      <span class="label">The Build</span>
      <h2>Your AIOS and your HQ, live in 10 business days.</h2>
      <div class="build-card">
        <div>
          <p class="build-price">{build}</p>
          <p class="build-note">One fixed price. Live within 10 business days of your setup call, or 10% back for every week it's late.</p>
          <div class="your-time">
            <p class="yt-h"><b>About 5 hours of your time.</b> The rest is mine.</p>
            <div class="yt-bar" aria-hidden="true">{ownerTime.map(([, m]) => <i style={`flex:${m}`}></i>)}</div>
            <ul class="yt-list">{ownerTime.map(([n, m]) => <li><span>{n}</span>{m} min</li>)}</ul>
          </div>
          <p class="build-note">No software licenses. It runs in your own accounts, so you pay only for hosting and the AI, about $200 to $300/month, straight to them.</p>
        </div>
        <a class="btn" href="/book-a-call">Book a Call <svg class="arrow"><use href="#arrow" /></svg></a>
      </div>
      <h3 class="whats-in">What you get: two things, both yours</h3>
      <AiosScreens />
      <p class="smaller">Up to three of your systems connected; each one past that is {day}. <a class="text-link" href="/process">How the 10 days go <svg class="arrow"><use href="#arrow" /></svg></a></p>
    </div>
  </section>


  <section class="block proof-sec">
    <div class="wrap">
      <span class="label">Proof</span>
      <h2>I built one for my own business first. Then for my clients.</h2>
      <div class="proofs">
        <a class="proof reveal" href="/case-studies/my-own-aios">
          <div class="p-img"><Image src={ownImg} alt="The Pipelines screen in my own HQ." widths={[600, 900, 1200]} sizes="(min-width: 900px) 560px, 100vw" loading="lazy" /></div>
          <div class="p-body">
            <span class="p-who">My own two businesses</span>
            <p class="p-n">36</p>
            <p class="p-l">automations running every day, on the same system I build for clients</p>
            <span class="text-link">How I run it <svg class="arrow"><use href="#arrow" /></svg></span>
          </div>
        </a>
        <a class="proof reveal" href="/case-studies/sheffler-and-company">
          <div class="p-img"><Image src={shefflerImg} alt="The lead queue in the Sheffler &amp; Company portal, shown with demo data." widths={[600, 900, 1200]} sizes="(min-width: 900px) 560px, 100vw" loading="lazy" /></div>
          <div class="p-body">
            <span class="p-who">Sheffler &amp; Company, a 50-year-old engineering firm</span>
            <p class="p-n">150+</p>
            <p class="p-l">proposals their team has written in software they own, a routine one in half the time</p>
            <span class="text-link">See what I built <svg class="arrow"><use href="#arrow" /></svg></span>
          </div>
        </a>
      </div>
      <div class="familiar-cta"><a class="btn" href="/book-a-call">Book a Call <svg class="arrow"><use href="#arrow" /></svg></a></div>
    </div>
  </section>

  <section class="block">
    <div class="wrap how">
      <figure class="portrait reveal">
        <Image src={portrait} alt="Mark Szymanski" widths={[480, 800, 1100]} sizes="(min-width: 1024px) 460px, 90vw" />
        <figcaption><b>Mark Szymanski</b><span>Founder, Motive11</span></figcaption>
      </figure>
      <div>
        <span class="label">Who does the work</span>
        <h2>One person and a lot of AI, instead of an agency and a lot of meetings.</h2>
        <p class="how-lead">You know your industry. I know AI. I use it for the judgment calls, and to build the pieces you do over and over so they run on their own. The AI does about 90% of the work, and your team checks it.</p>
      </div>
    </div>
  </section>

  <AfterBuild />

  {quote && (
    <section class="quote">
      <div class="wrap">
        <Testimonial q={quote} variant="feature" link="/case-studies/sheffler-and-company" />
      </div>
    </section>
  )}

  <ClosingCta />
</BaseLayout>

<script is:inline>
  (function () {
    var root = document.querySelector("[data-showcase]");
    if (!root) return;
    var screens = root.querySelectorAll("[data-screen]");
    var dots = root.querySelectorAll("[data-dot]");
    var addr = root.querySelector("[data-addr]");
    var cap = root.querySelector("[data-cap]");
    var link = root.querySelector("[data-caption-link]");
    var track = root.querySelector("[data-track]");
    // Below 1024px the screens are a native scroll-snap row so a finger can swipe them; above it they crossfade.
    var swipe = matchMedia("(max-width: 1023px)");
    var calm = matchMedia("(prefers-reduced-motion: reduce)");
    var lean = navigator.connection && navigator.connection.saveData;
    var vids = Array.prototype.map.call(screens, function (s) { return lean ? null : s.querySelector("video"); });
    var i = 0, timer = null, settle = null, held = false, inView = true;

    // Only the recording on screen and the next one ever download, so a visitor who never watches
    // past the first site pays for two recordings, not all of them.
    // Narrow screens get the 1280x800 "-m" copy: the full 1920x1200 files are H.264 level 5.0, and phones lagged on them.
    function load(v) {
      if (!v || v.src || calm.matches) return;
      v.src = swipe.matches ? v.dataset.video.replace(/\.mp4$/, "-m.mp4") : v.dataset.video;
      v.preload = "auto";
    }
    function nextVideo(n) {
      for (var k = 1; k < vids.length; k++) { var v = vids[(n + k) % vids.length]; if (v) return v; }
      return null;
    }
    function play(n) {
      var v = vids[n];
      if (!v || calm.matches || !inView) return;
      load(v);
      var p = v.play();
      // iOS Low Power Mode refuses muted autoplay; treat that slide as a still from then on.
      if (p && p.catch) p.catch(function (e) { if (e && e.name === "NotAllowedError") { vids[n] = null; if (n === i) start(); } });
    }
    vids.forEach(function (v, n) {
      if (!v) return;
      v.addEventListener("playing", function () { v.classList.add("is-live"); load(nextVideo(n)); });
      // Each recording ends on half a second of one held frame, so the crossfade starts while it is still moving.
      v.addEventListener("timeupdate", function () { if (n === i && !held && v.duration && v.currentTime > v.duration - 1.3) show(i + 1); });
      v.addEventListener("error", function () { vids[n] = null; if (n === i) start(); });
    });

    function show(n, fromScroll) {
      var was = vids[i], left = i;
      screens[i].classList.remove("is-on"); dots[i].classList.remove("is-on"); dots[i].removeAttribute("aria-current");
      i = (n + screens.length) % screens.length;
      screens[i].classList.add("is-on"); dots[i].classList.add("is-on"); dots[i].setAttribute("aria-current", "true");
      addr.textContent = screens[i].dataset.addrText;
      cap.textContent = screens[i].dataset.caption;
      link.setAttribute("href", screens[i].dataset.href);
      if (swipe.matches && !fromScroll) track.scrollTo({ left: i * track.clientWidth, behavior: "smooth" });
      // Rewind after the crossfade, so the slide fades out still moving and comes back on its first frame.
      if (was && left !== i) setTimeout(function () { if (i !== left) { was.pause(); was.currentTime = 0; } }, 750);
      play(i);
      start();
    }

    // A recording advances the slideshow just before it ends. The timer covers stills, and is the backstop for
    // a recording that stalls on a slow connection.
    function start() {
      clearTimeout(timer); timer = null;
      if (held || calm.matches || !inView) return;
      var v = vids[i];
      timer = setTimeout(function () { show(i + 1); }, v ? 18000 : 4500);
    }
    function stop() { clearTimeout(timer); timer = null; }
    function hold() { held = true; stop(); }
    function release() { held = false; start(); }

    dots.forEach(function (d) { d.addEventListener("click", function () { show(Number(d.dataset.dot)); }); });
    root.addEventListener("mouseenter", hold);
    root.addEventListener("mouseleave", release);
    track.addEventListener("touchstart", hold, { passive: true });
    track.addEventListener("touchend", release, { passive: true });
    track.addEventListener("scroll", function () {
      if (!swipe.matches) return;
      clearTimeout(settle);
      settle = setTimeout(function () {
        var n = Math.round(track.scrollLeft / track.clientWidth);
        if (n !== i) show(n, true);
      }, 90);
    }, { passive: true });
    swipe.addEventListener("change", function () { if (swipe.matches) track.scrollLeft = i * track.clientWidth; });

    // Off screen nothing plays, so a visitor reading further down isn't decoding video they can't see.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (es) {
        inView = es[0].isIntersecting;
        if (inView) { play(i); start(); }
        else { stop(); if (vids[i]) vids[i].pause(); }
      }).observe(root);
    }
    document.addEventListener("visibilitychange", function () {
      if (document.hidden) { stop(); if (vids[i]) vids[i].pause(); }
      else if (inView) { play(i); start(); }
    });
    // The first recording waits for the page to finish loading, so it never competes with the hero's own image.
    if (document.readyState === "complete") play(i);
    else addEventListener("load", function () { play(i); });
    start();
  })();
</script>

<style>
  .hero { text-align: center; padding-top: clamp(64px, 9vw, 120px); overflow-x: clip; }
  .pill { display: inline-flex; align-items: center; gap: 10px; padding: 7px 14px 7px 8px; border: 1px solid var(--line); background: var(--surface); border-radius: 999px; color: var(--muted); font-size: 14px; font-weight: 500; text-decoration: none; transition: border-color 0.15s ease, color 0.15s ease; }
  .pill:hover { color: var(--fg); border-color: rgba(255, 106, 26, 0.5); }
  .pill .dot { width: 22px; height: 22px; border-radius: 50%; background: rgba(255, 106, 26, 0.16); display: grid; place-items: center; flex: none; }
  .pill .dot::after { content: ""; width: 7px; height: 7px; border-radius: 50%; background: var(--orange); }
  .pill .arrow { width: 14px; height: 14px; }
  h1 { max-width: 13.5em; margin: 30px auto 0; }
  .sub { margin: 26px auto 0; max-width: 35em; font-size: 20px; line-height: 1.55; color: var(--muted); letter-spacing: -0.01em; text-wrap: pretty; }
  .sub b { color: var(--fg); font-weight: 500; }
  .name { color: var(--fg); font-weight: 500; white-space: nowrap; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 16px 30px; margin-top: 38px; }

  .stage { position: relative; margin-top: clamp(56px, 7vw, 88px); }
  .stage::before {
    content: ""; position: absolute; left: 50%; bottom: 40px; width: 120%; height: 95%; transform: translateX(-50%);
    background: radial-gradient(ellipse 52% 60% at 50% 100%, var(--glow), rgba(255, 106, 26, 0.18) 45%, transparent 74%);
    filter: blur(20px); pointer-events: none;
  }
  .browser { position: relative; max-width: 1100px; margin: 0 auto; border-radius: 14px; background: var(--surface); border: 1px solid var(--line); padding: 0 8px 8px; box-shadow: 0 40px 90px -30px var(--shadow); }
  .bar { display: flex; align-items: center; gap: 14px; height: 40px; padding-inline: 8px; }
  .lights { display: flex; gap: 7px; }
  .lights i { width: 11px; height: 11px; border-radius: 50%; background: #FF5F57; box-shadow: inset 0 0 0 0.5px rgba(0, 0, 0, 0.14); }
  .lights i:nth-child(2) { background: #FEBC2E; }
  .lights i:nth-child(3) { background: #28C840; }
  .addr { flex: 1; max-width: 340px; margin: 0 auto; height: 24px; border-radius: 6px; background: var(--surface-2); color: var(--muted); font-size: 12px; display: flex; align-items: center; justify-content: center; gap: 6px; white-space: nowrap; overflow: hidden; padding-inline: 10px; }
  .addr span { overflow: hidden; text-overflow: ellipsis; }
  .lock { width: 10px; height: 10px; flex: none; fill: currentColor; opacity: 0.7; }
  .spacer { width: 47px; }
  .screens { position: relative; aspect-ratio: 16 / 10; border-radius: 7px; overflow: hidden; background: var(--surface-2); }
  .screen { position: absolute; inset: 0; opacity: 0; transition: opacity 0.7s ease; }
  .screen.is-on { opacity: 1; }
  .screen :global(img), .screen video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .screen video { opacity: 0; transition: opacity 0.3s ease; }
  .screen video.is-live { opacity: 1; }
  .showcase-foot { position: relative; display: grid; justify-items: center; gap: 14px; margin-top: 22px; }
  .showcase-foot .caption { margin: 0; min-height: 3em; }
  .dots { display: flex; gap: 16px; }
  /* The padding is the tap target (24px, the accessibility minimum) and the negative margin takes it
     back out of the layout, so only the 8px dot shows and the row keeps its size. */
  .dots .dot { box-sizing: content-box; width: 8px; height: 8px; padding: 8px; margin: -8px; border-radius: 999px; border: 0; background-color: var(--faint); background-clip: content-box; cursor: pointer; transition: width 0.3s ease, background 0.3s ease; }
  .dots .dot.is-on { width: 24px; background-color: var(--orange); }
  .caption { position: relative; margin: 22px auto 0; max-width: 40em; color: var(--muted); font-size: 15px; }
  .caption a { color: var(--fg); text-decoration: none; font-weight: 500; border-bottom: 1px solid rgba(255, 106, 26, 0.6); }
  .caption a:hover { color: var(--accent-text); }

  .logos-wrap { padding-top: clamp(64px, 8vw, 96px); }

  .risk-sec h2 { max-width: 20em; }
  .proof-sec h2 { max-width: 16em; }
  .risk-lead { margin-top: 20px; max-width: 34em; color: var(--muted); font-size: 19px; line-height: 1.55; }
  .risks { display: grid; gap: 14px; margin-top: 48px; }
  .risk { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 16px; padding: 26px; }
  .r-ic { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 12px; background: rgba(255, 106, 26, 0.12); color: var(--orange); }
  .r-ic svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .risk h3 { margin-top: 20px; font-weight: 500; font-size: 22px; letter-spacing: -0.02em; }
  .risk p { margin-top: 10px; color: var(--muted); font-size: 17px; line-height: 1.55; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 22px; }
  .chips span { padding: 6px 12px; border-radius: 999px; border: 1px solid var(--line); font-size: 14px; color: var(--fg); }
  .chips em { flex-basis: 100%; font-style: normal; color: var(--faint); font-size: 13px; }
  .chips.gone span { color: var(--faint); text-decoration: line-through; text-decoration-color: var(--orange); border-style: dashed; }
  .chips.locked span { border-color: rgba(255, 106, 26, 0.45); }
  .chips.scattered span:nth-child(2n) { transform: rotate(-3deg); }
  .chips.scattered span:nth-child(3n) { transform: rotate(4deg) translateY(3px); }
  .fix { margin-top: 40px; max-width: 44em; font-size: 19px; line-height: 1.55; }
  .proofs { display: grid; gap: 16px; margin-top: 44px; }
  .proof { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; text-decoration: none; color: inherit; transition: border-color 0.2s; }
  .proof:hover { border-color: var(--orange); }
  .p-img { aspect-ratio: 16 / 9; overflow: hidden; background: #f4f2ee; border-bottom: 1px solid var(--line); }
  .p-img :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .p-body { display: flex; flex-direction: column; flex: 1; padding: 24px 26px 26px; }
  .p-who { color: var(--muted); font-size: 15px; }
  .p-n { margin-top: 14px; font-size: clamp(44px, 5vw, 60px); font-weight: 600; letter-spacing: -0.03em; line-height: 1; color: var(--orange); }
  .p-l { margin-top: 10px; font-size: 17px; line-height: 1.5; max-width: 26em; }
  .p-body .text-link { margin-top: auto; padding-top: 20px; }
  .build-card { margin-top: 36px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px 32px; background: var(--surface); border: 1px solid rgba(255, 106, 26, 0.45); border-radius: 18px; padding: clamp(22px, 3vw, 32px); }
