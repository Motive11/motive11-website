---
import BaseLayout from "../layouts/BaseLayout.astro";
import ClientLogos from "../components/ClientLogos.astro";
import { breadcrumb } from "../lib/schema";
import { site } from "../lib/site";

const title = "How I Work - Motive11";
const description = "How I work with a business: learn how it runs, build it in your own accounts, let AI draft while people decide, and keep it running after.";

const steps = [
  {
    title: "I start with the business, not the technology.",
    body: "Your data first, then short conversations with you and the people who actually do the work: how work comes in, who does what, and where it gets stuck. Nothing gets built until I know how the place really runs.",
  },
  {
    title: "Everything goes in your accounts.",
    body: "Your company's name, your card, your logins. Nothing about your business lives in my accounts, and if you ever stop working with me, I remove myself and you keep everything.",
  },
  {
    title: "AI drafts. A person decides.",
    body: "The AI does the repetitive work: the research, the first draft, the follow-up. Anything that sends, posts, or spends money waits for someone on your team to approve it.",
  },
  {
    title: "Built once, then kept running.",
    body: "The Build is a fixed price and done in 10 business days. After that you choose: I keep building on it, I keep it running, or you run it yourself.",
  },
];

const why = [
  {
    title: "You know the price before we talk.",
    body: "The Build is one fixed price, and so is everything after it. No hourly billing, no estimate that grows, no surprise invoice.",
  },
  {
    title: "Most of my clients stay.",
    body: "Several have been with me for years. The work usually grows from one project into the system the whole office runs on.",
  },
  {
    title: "I run my own business this way.",
    body: "My clients, my money, my content, and the context behind all of it live in one AIOS I built for myself first. It's the same thing I build for you.",
  },
];

const wont = [
  "Keep your systems in my accounts, or hold anything hostage.",
  "Build something you asked for that I don't think will work.",
  "Take on a business I don't think I can actually help.",
  "Hide behind jargon. If I can't explain a decision in plain language, it's the wrong decision.",
  "Disappear after launch.",
];
---

<BaseLayout title={title} description={description} schema={[breadcrumb([{ name: "Home", url: site.url }, { name: "How I Work", url: `${site.url}/how-i-work` }])]}>
  <section class="hero">
    <div class="wrap center">
      <span class="label">How I work</span>
      <h1>I learn how your business runs. Then I build it into something you own.</h1>
      <p class="lead">The rules I hold myself to, from the first call to years after.</p>
    </div>
  </section>

  <section class="block tint">
    <div class="wrap reveal">
      <div class="narrow">
        <h2 class="center">How it goes.</h2>
        <div class="steps">
          {steps.map((step, i) => (
            <div class="step">
              <span class="n">0{i + 1}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="block amp">
    <div class="wrap center reveal">
      <span class="label">Where AI fits</span>
      <h2>AI does most of the building. I do the orchestrating.</h2>
      <p class="amp-body">That's how one person moves like a team. It goes faster than you're probably used to, because someone who knows what to build has AI building it, and that speed comes to you as more shipped work.</p>
    </div>
  </section>

  <section class="block tint">
    <div class="wrap reveal">
      <h2 class="center">Why it works this way.</h2>
      <div class="cards">
        {why.map((item) => (
          <div class="card">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap reveal">
      <div class="narrow">
        <h2 class="center">What I won't do.</h2>
        <ul class="crosses">
          {wont.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <div class="wrap logos"><ClientLogos /></div>

  <section class="close">
    <div class="wrap center inner">
      <h2>If this is how you'd want it done, let's talk.</h2>
      <div class="actions">
        <a class="btn" href="/book-a-call">Book a Call <svg class="arrow"><use href="#arrow" /></svg></a>
        <a class="btn ghost" href="/case-studies/my-own-aios">See how I run my own business</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .center { text-align: center; }
  .center h1, .center h2, h2.center { margin-inline: auto; }
  .narrow { max-width: 760px; margin-inline: auto; }

  .hero { padding-block: clamp(64px, 9vw, 120px) clamp(64px, 8vw, 104px); }
  .hero h1 { font-size: clamp(38px, 5vw, 64px); max-width: 13em; }
  .lead { color: var(--muted); font-size: 20px; max-width: 30em; margin: 26px auto 0; text-wrap: pretty; }

  .tint { background: var(--surface); border-block: 1px solid var(--line); }
  .amp h2 { font-size: clamp(30px, 3.6vw, 46px); max-width: 15em; }
  .amp-body { color: var(--muted); font-size: 19px; line-height: 1.6; max-width: 34em; margin: 24px auto 0; text-wrap: pretty; }
  h2 { max-width: 18em; }

  .steps { margin-top: 44px; border-top: 1px solid var(--line); }
  .step { display: grid; grid-template-columns: 52px 1fr; gap: 6px 10px; padding-block: 28px; border-bottom: 1px solid var(--line); }
  .step .n { color: var(--accent-text); font-weight: 500; font-size: 22px; line-height: 1.25; }
  .step h3 { font-weight: 500; font-size: 22px; letter-spacing: -0.025em; line-height: 1.3; }
  .step p { grid-column: 2; color: var(--muted); line-height: 1.65; }

  .cards { display: grid; gap: 16px; margin-top: 44px; }
  .card { background: var(--bg); border: 1px solid var(--line); border-radius: 16px; padding: 30px; }
  .card h3 { font-weight: 500; font-size: 23px; letter-spacing: -0.025em; line-height: 1.25; margin-bottom: 12px; }
  .card p { color: var(--muted); font-size: 16px; line-height: 1.65; }

  .crosses { list-style: none; padding: 0; margin: 40px 0 0; border-top: 1px solid var(--line); }
  .crosses li { position: relative; padding: 18px 0 18px 34px; border-bottom: 1px solid var(--line); font-size: 18px; line-height: 1.55; }
  .crosses li::before { content: "\00d7"; position: absolute; left: 2px; top: 13px; color: var(--accent-text); font-size: 26px; line-height: 1; }

  .logos { padding-block: clamp(72px, 9vw, 112px) 0; }

  .close { position: relative; overflow: hidden; padding-block: clamp(90px, 11vw, 140px) clamp(100px, 12vw, 150px); }
  .close::before {
    content: ""; position: absolute; left: 50%; bottom: -40%; width: 1100px; max-width: 160%; height: 90%; transform: translateX(-50%);
    background: radial-gradient(ellipse 50% 50% at 50% 100%, var(--glow), transparent 70%);
    opacity: 0.55; filter: blur(10px); pointer-events: none;
  }
  .inner { position: relative; }
  .close h2 { font-size: clamp(34px, 4.4vw, 56px); max-width: 14em; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 14px; margin-top: 36px; }

  @media (min-width: 1024px) {
    .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .lead { font-size: 18px; }
    .step { grid-template-columns: 40px 1fr; }
    .crosses li { font-size: 17px; }
  }
</style>
