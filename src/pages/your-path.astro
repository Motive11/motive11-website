---
// Draft for Mark (November 20, 2026), noindex and unlinked until he approves it. The revenue and team
// options are copied from the Intro Call form (the motive11 `intro` booking type in AIOS) and the
// routing is the intro-call cheat sheet (AIOS entities/motive11/context/process/intro-call.md), so a
// change to either belongs there first.
import BaseLayout from "../layouts/BaseLayout.astro";
import { pricing, usd } from "../lib/pricing";

const day = usd(pricing.onboardingDay.rate);
const monthly = usd(pricing.fractional.monthly);
const teamCap = pricing.fractional.teamSize;

const questions = [
  {
    id: "team",
    q: "How many people are on your team?",
    options: [
      ["lt10", "Under 10"],
      ["10to50", "10 to 50"],
      ["51to100", "51 to 100"],
      ["100plus", "More than 100"],
    ],
  },
  {
    id: "revenue",
    q: "Roughly what's your annual revenue?",
    options: [
      ["lt3", "Under $3M"],
      ["3to10", "$3M to $10M"],
      ["10to50", "$10M to $50M"],
      ["50plus", "$50M and up"],
    ],
  },
  {
    id: "ai",
    q: "Are you already using AI at all?",
    options: [
      ["none", "Not yet"],
      ["some", "Some, here and there"],
      ["daily", "Every day"],
    ],
  },
  {
    id: "goal",
    q: "What are you looking to hire for?",
    options: [
      ["setup", "Just get it set up"],
      ["one", "Solve one problem"],
      ["partner", "A partner to fix a few things, ongoing"],
      ["inhouse", "Someone to build it and teach the team, so it comes in-house"],
    ],
  },
];
---

<BaseLayout
  title="Your Path - Motive11"
  description="A few questions, and I'll tell you how I'd work with your business."
  noindex
>
  <div class="draft-bar">Draft for Mark. Not linked anywhere, not indexed.</div>
  <section class="block path">
    <div class="wrap narrow">
      <span class="label">Find your path</span>
      <h1>Find out how I'd work with your business.</h1>

      <div class="quiz" data-quiz>
        <div class="progress" aria-hidden="true"><i data-bar></i></div>
        {questions.map((qu, i) => (
          <fieldset class="step" data-step={i} hidden={i !== 0}>
            <legend><span class="num">{i + 1} of {questions.length}</span>{qu.q}</legend>
            <div class="opts">
              {qu.options.map(([v, text]) => (
                <button type="button" class="opt" data-q={qu.id} data-v={v}>{text}</button>
              ))}
            </div>
            {i > 0 && <button type="button" class="back" data-back>Back</button>}
          </fieldset>
        ))}

        <div class="result" data-result="day" hidden>
          <span class="label">Your path</span>
          <h2>The AI Onboarding Day</h2>
          <p class="body">One day, {day}, paid once. I learn how your business runs, put it in one place you own, and leave AI doing real work on it.</p>
          <p class="body" data-note="after">If you want me on it every month after that, that's Fractional.</p>
          <div class="actions">
            <a class="btn" href="/ai-onboarding-day">See the AI Onboarding Day <svg class="arrow"><use href="#arrow" /></svg></a>
            <a class="text-link" href="/fractional">How Fractional works <svg class="arrow"><use href="#arrow" /></svg></a>
          </div>
          <p class="own">Everything I build lives in your own accounts, so you own all of it.</p>
          <button type="button" class="back" data-restart>Start over</button>
        </div>

        <div class="result" data-result="fractional" hidden>
          <span class="label">Your path</span>
          <h2>Fractional</h2>
          <p class="body">I'm your AI and systems lead, every month. At kickoff I learn how the business runs and pick the one number to move. Then I build whatever moves it.</p>
          <p class="body" data-note="inhouse">You want it in-house, so I plan the handoff from day one and train your people along the way.</p>
          <p class="body price" data-price="std">{monthly}/month, three-month minimum, then month to month.</p>
          <p class="body price" data-price="big">For a team over {teamCap}, I quote it on the call.</p>
          <div class="actions">
            <a class="btn" href="/book/intro">Book a 20-minute intro call <svg class="arrow"><use href="#arrow" /></svg></a>
            <a class="text-link" href="/fractional">How Fractional works <svg class="arrow"><use href="#arrow" /></svg></a>
          </div>
          <p class="own">Everything I build lives in your own accounts, so you own all of it. If you ever want to end it, I get out of your systems and you keep everything.</p>
          <button type="button" class="back" data-restart>Start over</button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type A = Record<string, string>;

  function route(a: A): string {
    if (a.goal === "setup") return "day";
    if (a.revenue === "lt3") return "day";
    if (a.revenue === "3to10" && a.team === "lt10") return "day";
    return "fractional";
  }

  const quiz = document.querySelector<HTMLElement>("[data-quiz]")!;
  const steps = [...quiz.querySelectorAll<HTMLElement>("[data-step]")];
  const bar = quiz.querySelector<HTMLElement>("[data-bar]")!;
  const answers: A = {};
  let at = 0;

  function show(i: number) {
    at = i;
    steps.forEach((s, n) => (s.hidden = n !== i));
    quiz.querySelectorAll<HTMLElement>("[data-result]").forEach((r) => (r.hidden = true));
    bar.style.width = `${(i / steps.length) * 100}%`;
  }

  function finish() {
    const key = route(answers);
    steps.forEach((s) => (s.hidden = true));
    bar.style.width = "100%";
    const box = quiz.querySelector<HTMLElement>(`[data-result="${key}"]`)!;
    const big = answers.team === "51to100" || answers.team === "100plus";
    box.querySelectorAll<HTMLElement>("[data-note='inhouse']").forEach((n) => (n.hidden = answers.goal !== "inhouse"));
    box.querySelectorAll<HTMLElement>("[data-note='after']").forEach((n) => (n.hidden = answers.goal === "setup"));
    box.querySelectorAll<HTMLElement>("[data-price='std']").forEach((n) => (n.hidden = big));
    box.querySelectorAll<HTMLElement>("[data-price='big']").forEach((n) => (n.hidden = !big));
    box.hidden = false;
  }

  quiz.addEventListener("click", (e) => {
    const t = (e.target as HTMLElement).closest("button");
    if (!t) return;
    if (t.dataset.q) {
      answers[t.dataset.q] = t.dataset.v!;
      steps[at].querySelectorAll(".opt").forEach((o) => o.classList.toggle("is-on", o === t));
      at + 1 < steps.length ? show(at + 1) : finish();
    } else if (t.hasAttribute("data-back")) {
      show(Math.max(0, at - 1));
    } else if (t.hasAttribute("data-restart")) {
      for (const k of Object.keys(answers)) delete answers[k];
      quiz.querySelectorAll(".opt.is-on").forEach((o) => o.classList.remove("is-on"));
      show(0);
    }
  });
</script>

<style>
  .draft-bar { background: var(--orange); color: #1E1E1F; text-align: center; font-weight: 600; font-size: 14px; padding: 8px 16px; }
  .narrow { max-width: 760px; }
  .path h1 { font-size: clamp(32px, 5vw, 52px); line-height: 1.08; letter-spacing: -0.02em; margin: 0; text-wrap: balance; }
  .quiz { margin-top: 44px; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: clamp(22px, 4vw, 40px); }
  .progress { height: 4px; background: var(--line); border-radius: 4px; overflow: hidden; margin-bottom: 28px; }
  .progress i { display: block; height: 100%; width: 0; background: var(--orange); transition: width 0.25s ease; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { font-size: clamp(22px, 3vw, 28px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; padding: 0; }
  .num { display: block; font-size: 14px; font-weight: 500; color: var(--faint); margin-bottom: 10px; letter-spacing: 0; }
  .opts { display: grid; gap: 10px; margin-top: 22px; }
  .opt { text-align: left; font: inherit; font-size: 18px; color: var(--fg); background: transparent; border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; cursor: pointer; transition: border-color 0.15s ease, background 0.15s ease; }
  .opt:hover, .opt:focus-visible { border-color: var(--orange); outline: none; }
  .opt.is-on { border-color: var(--orange); background: color-mix(in srgb, var(--orange) 10%, transparent); }
  .back { margin-top: 18px; font: inherit; font-size: 15px; color: var(--muted); background: none; border: 0; padding: 4px 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .back:hover { color: var(--fg); }
  .result h2 { font-size: clamp(30px, 4.5vw, 44px); letter-spacing: -0.02em; margin: 0; line-height: 1.1; }
  .result .label { margin-bottom: 10px; }
  .result .body { font-size: 19px; line-height: 1.55; margin: 16px 0 0; color: var(--fg); }
  .result .price { font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 28px; }
  .own { margin: 28px 0 0; padding-top: 22px; border-top: 1px solid var(--line); color: var(--muted); font-size: 16px; line-height: 1.5; }
</style>
