---
// Draft for Mark (November 20, 2026): a few questions that end on the one offer that fits. Lives on a
// preview branch until he approves the questions and the routing; noindex until then. The HQ Day
// outcome is a proposal, not an offer on sale (AIOS entities/motive11/context/offers/).
import BaseLayout from "../layouts/BaseLayout.astro";
import { pricing, usd } from "../lib/pricing";

const day = usd(pricing.onboardingDay.rate);
const monthly = usd(pricing.fractional.monthly);

const questions = [
  {
    id: "rev",
    q: "About how much does the business bring in a year?",
    options: [
      ["lt1", "Under $1M"],
      ["1to3", "$1M to $3M"],
      ["3to10", "$3M to $10M"],
      ["10plus", "$10M or more"],
    ],
  },
  {
    id: "team",
    q: "How many people would use what I build?",
    hint: "Count the people at a desk: the office, managers, sales. Not a field crew that never touches it.",
    options: [
      ["me", "Just me"],
      ["small", "2 to 9"],
      ["mid", "10 to 50"],
      ["big", "More than 50"],
    ],
  },
  {
    id: "problem",
    q: "What are you trying to fix?",
    options: [
      ["one", "One clear thing that eats our time"],
      ["list", "A list that keeps growing"],
      ["unsure", "Not sure yet. I just know we're behind."],
    ],
  },
  {
    id: "two",
    q: "Two years from now, who runs it?",
    options: [
      ["team", "My own team"],
      ["partner", "You, as our partner"],
      ["setup", "Just set it up and I'll take it from there"],
      ["unsure", "I haven't thought about it"],
    ],
  },
  {
    id: "ai",
    q: "Is anyone using ChatGPT or Claude today?",
    options: [
      ["none", "Not really"],
      ["some", "A few of us, here and there"],
      ["daily", "Every day"],
    ],
  },
];

const results = {
  fractional: {
    label: "Your path",
    title: "Fractional",
    body: `You want a number to move and someone accountable for it every week. At kickoff I learn how the business runs, pick the one number we're going to move (more revenue, or more organized), and build whatever moves it next. ${monthly}/month, three-month minimum, then month to month.`,
    cta: ["Book a 20-minute intro call", "/book/intro"],
    more: ["How Fractional works", "/fractional"],
  },
  own: {
    label: "Your path",
    title: "Build it, own it",
    body: `Start with the AI Onboarding Day (${day}). I learn how the business runs, write it down in one place you own, and get AI doing real work on it before I leave. Then an HQ Day: your own screen on top of it, built in your accounts and documented. After that you can stop and run it yourself, or keep me on.`,
    draft: "HQ Day is a draft. It isn't on sale yet and has no price.",
    cta: ["See the AI Onboarding Day", "/ai-onboarding-day"],
    more: ["How Fractional works", "/fractional"],
  },
  day: {
    label: "Your path",
    title: "The AI Onboarding Day",
    body: `One day, ${day}, paid once. I learn how the business runs, write it down in one place you own, and get AI doing real work on it before I leave. If you want ongoing help after that, Fractional is the next step.`,
    cta: ["See the AI Onboarding Day", "/ai-onboarding-day"],
    more: ["How Fractional works", "/fractional"],
  },
  free: {
    label: "Your path",
    title: "Start with the newsletter",
    body: "Honestly, you don't need to pay me yet. Every Tuesday I write about what I'm building for businesses and what it changed for them. When the business is ready for more, you'll know what to ask for.",
    cta: ["Get the newsletter", "/newsletter"],
    more: ["See the work", "/case-studies"],
  },
};
---

<BaseLayout
  title="Your Path - Motive11"
  description="Five questions, and I'll tell you which way of working with me fits your business."
  noindex
>
  <div class="draft-bar">Draft for Mark. Not linked anywhere, not indexed.</div>
  <section class="block path">
    <div class="wrap narrow">
      <span class="label">Find your path</span>
      <h1>Five questions. Then I'll tell you how I'd work with you.</h1>
      <p class="lead">No email needed. Whatever I build lives in your own accounts, so you own all of it, whichever path you land on.</p>

      <div class="quiz" data-quiz>
        <div class="progress" aria-hidden="true"><i data-bar></i></div>
        {questions.map((qu, i) => (
          <fieldset class="step" data-step={i} hidden={i !== 0}>
            <legend><span class="num">{i + 1} of {questions.length}</span>{qu.q}</legend>
            {qu.hint && <p class="hint">{qu.hint}</p>}
            <div class="opts">
              {qu.options.map(([v, text]) => (
                <button type="button" class="opt" data-q={qu.id} data-v={v}>{text}</button>
              ))}
            </div>
            {i > 0 && <button type="button" class="back" data-back>Back</button>}
          </fieldset>
        ))}

        {Object.entries(results).map(([key, r]) => (
          <div class="result" data-result={key} hidden>
            <span class="label">{r.label}</span>
            <h2>{r.title}</h2>
            <p class="body">{r.body}</p>
            <ul class="why" data-why></ul>
            {"draft" in r && <p class="draft-note">{r.draft}</p>}
            <div class="actions">
              <a class="btn" href={r.cta[1]}>{r.cta[0]} <svg class="arrow"><use href="#arrow" /></svg></a>
              <a class="text-link" href={r.more[1]}>{r.more[0]} <svg class="arrow"><use href="#arrow" /></svg></a>
            </div>
            <p class="own">Whichever way you go, everything I build lives in your own accounts. You own all of it, and if you ever want to end it, I get out of your systems and you keep everything.</p>
            <button type="button" class="back" data-restart>Start over</button>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  type A = Record<string, string>;

  // The routing mirrors the intro call cheat sheet and icps.md: revenue says whether Fractional is
  // possible at all, team size and the two-year answer say which way. Change it there first.
  function route(a: A): string {
    if (a.rev === "lt1") return "free";
    if (a.rev === "1to3") {
      if (a.ai === "none") return "free";
      if (a.problem === "one" && (a.two === "team" || a.two === "setup")) return "own";
      return "day";
    }
    if (a.two === "setup") return "own";
    if (a.team === "mid" || a.team === "big" || a.rev === "10plus") return "fractional";
    return a.two === "partner" ? "day" : "own";
  }

  function why(a: A, result: string): string[] {
    const out: string[] = [];
    if (result === "fractional") {
      if (a.problem === "list") out.push("You have a list, not one problem. That's what a partner is for.");
      if (a.team === "mid" || a.team === "big") out.push("A real team will use it, so it has to keep changing as they do.");
      if (a.two === "team") out.push("You want your own team running it in two years. Good: I plan the handoff from kickoff, and they're trained as we go.");
      if (a.two === "partner") out.push("You want a partner, not a one-time setup.");
    }
    if (result === "own") {
      if (a.two === "setup") out.push("You want it set up, then you'll take it from there.");
      if (a.two === "team") out.push("You want your own team running it, so you should own it from day one.");
      if (a.problem === "one") out.push("You have one clear thing to fix, so a fixed scope fits.");
    }
    if (result === "day") {
      if (a.ai !== "none") out.push("You're already using AI and want it set up right.");
      if (a.rev === "3to10") out.push("It's the way in. If you want ongoing help after, that's Fractional.");
    }
    if (result === "free") {
      if (a.rev === "lt1") out.push("At your size, paying me isn't the best use of your money yet.");
      else out.push("Nobody's using AI yet, so the first step is seeing what it can do, not paying someone to set it up.");
    }
    return out;
  }

  const quiz = document.querySelector<HTMLElement>("[data-quiz]")!;
  const steps = [...quiz.querySelectorAll<HTMLElement>("[data-step]")];
  const bar = quiz.querySelector<HTMLElement>("[data-bar]")!;
  const answers: A = {};
  let at = 0;

  function show(i: number) {
    at = i;
    steps.forEach((s, n) => (s.hidden = n !== i));
    quiz.querySelectorAll<HTMLElement>("[data-result]").forEach((r) => (r.hidden = true));
    bar.style.width = `${(i / steps.length) * 100}%`;
    steps[i].querySelector<HTMLButtonElement>(".opt")?.focus({ preventScroll: true });
  }

  function finish() {
    const key = route(answers);
    steps.forEach((s) => (s.hidden = true));
    bar.style.width = "100%";
    const box = quiz.querySelector<HTMLElement>(`[data-result="${key}"]`)!;
    const list = box.querySelector<HTMLElement>("[data-why]")!;
    list.replaceChildren(...why(answers, key).map((t) => Object.assign(document.createElement("li"), { textContent: t })));
    list.hidden = !list.children.length;
    box.hidden = false;
    box.querySelector<HTMLElement>("h2")?.focus?.();
  }

  quiz.addEventListener("click", (e) => {
    const t = (e.target as HTMLElement).closest("button");
    if (!t) return;
    if (t.dataset.q) {
      answers[t.dataset.q] = t.dataset.v!;
      steps[at].querySelectorAll(".opt").forEach((o) => o.classList.toggle("is-on", o === t));
      at + 1 < steps.length ? show(at + 1) : finish();
    } else if (t.hasAttribute("data-back")) {
      show(Math.max(0, at - 1));
    } else if (t.hasAttribute("data-restart")) {
      for (const k of Object.keys(answers)) delete answers[k];
      quiz.querySelectorAll(".opt.is-on").forEach((o) => o.classList.remove("is-on"));
      show(0);
    }
  });
</script>

<style>
  .draft-bar { background: var(--orange); color: #1E1E1F; text-align: center; font-weight: 600; font-size: 14px; padding: 8px 16px; }
  .narrow { max-width: 760px; }
  .path h1 { font-size: clamp(32px, 5vw, 52px); line-height: 1.08; letter-spacing: -0.02em; margin: 0; text-wrap: balance; }
  .quiz { margin-top: 44px; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: clamp(22px, 4vw, 40px); }
  .progress { height: 4px; background: var(--line); border-radius: 4px; overflow: hidden; margin-bottom: 28px; }
  .progress i { display: block; height: 100%; width: 0; background: var(--orange); transition: width 0.25s ease; }
  fieldset { border: 0; margin: 0; padding: 0; min-width: 0; }
  legend { font-size: clamp(22px, 3vw, 28px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; padding: 0; }
  .num { display: block; font-size: 14px; font-weight: 500; color: var(--faint); margin-bottom: 10px; letter-spacing: 0; }
  .hint { color: var(--muted); margin: 10px 0 0; font-size: 16px; }
  .opts { display: grid; gap: 10px; margin-top: 22px; }
  .opt { text-align: left; font: inherit; font-size: 18px; color: var(--fg); background: transparent; border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; cursor: pointer; transition: border-color 0.15s ease, background 0.15s ease; }
  .opt:hover, .opt:focus-visible { border-color: var(--orange); outline: none; }
  .opt.is-on { border-color: var(--orange); background: color-mix(in srgb, var(--orange) 10%, transparent); }
  .back { margin-top: 18px; font: inherit; font-size: 15px; color: var(--muted); background: none; border: 0; padding: 4px 0; cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .back:hover { color: var(--fg); }
  .result h2 { font-size: clamp(30px, 4.5vw, 44px); letter-spacing: -0.02em; margin: 0; line-height: 1.1; }
  .result .label { margin-bottom: 10px; }
  .result .body { font-size: 19px; line-height: 1.55; margin: 18px 0 0; color: var(--fg); }
  .why { margin: 18px 0 0; padding-left: 20px; color: var(--muted); font-size: 17px; line-height: 1.5; }
  .why li + li { margin-top: 6px; }
  .draft-note { margin: 16px 0 0; font-size: 15px; font-weight: 600; color: var(--accent-text); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 26px; margin-top: 28px; }
  .own { margin: 28px 0 0; padding-top: 22px; border-top: 1px solid var(--line); color: var(--muted); font-size: 16px; line-height: 1.5; }
</style>
